# Image Captioning Configuration
# Copy this file to config.yaml and customize as needed.
# CLI arguments will override these settings.

# Trigger word prepended to all captions
trigger_word: "ohwx man"

# Style tags appended to captions (optional)
style_tags: ""

# Gemini model to use
model: "gemini-2.5-pro"

# Number of images to process per API call
batch_size: 8

# API key (optional - can also use GEMINI_API_KEY environment variable)
# api_key: "your-api-key-here"

# Logging level: DEBUG, INFO, WARNING, ERROR
log_level: "INFO"
